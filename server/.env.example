# 线上（Vercel）在 Project Settings → Environments → Environment Variables 里配置
# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=blog

# JWT 签名密钥：换掉这个值会让所有人重新登录
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# AI 服务
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
